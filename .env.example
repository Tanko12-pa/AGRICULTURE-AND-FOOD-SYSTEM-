# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYPAL_CLIENT_ID: Client ID for PayPal Subscriptions and checkout (defaults to 'sb' for sandbox)
PAYPAL_CLIENT_ID="sb"

# PAYPAL_CLIENT_SECRET: Optional PayPal secret for server-side order captures
PAYPAL_CLIENT_SECRET=""

# PAYPAL_API_URL: PayPal API base endpoint (Sandbox: https://api-m.sandbox.paypal.com, Live: https://api-m.paypal.com)
PAYPAL_API_URL="https://api-m.sandbox.paypal.com"

# PAYPAL_PRODUCT_ID: PayPal Product Catalog ID for Agriculture & Food System subscription service
PAYPAL_PRODUCT_ID=""

# PAYPAL_PLAN_ID_MONTHLY: PayPal Billing Plan ID for Monthly Subscription ($19.99/mo)
PAYPAL_PLAN_ID_MONTHLY=""

# PAYPAL_PLAN_ID_YEARLY: PayPal Billing Plan ID for Yearly Subscription ($199.99/yr)
PAYPAL_PLAN_ID_YEARLY=""

