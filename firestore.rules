rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.id == request.auth.uid);
    }

    match /fieldObservations/{observationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /soilReadings/{readingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /subscriptions/{subId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
