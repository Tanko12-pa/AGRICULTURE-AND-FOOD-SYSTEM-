{
  "entities": {
    "users": {
      "fields": {
        "id": { "type": "string", "description": "User unique identifier" },
        "fullName": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "description": "Agri role (FIELD_TECH, AGRI_SUPERVISOR, etc.)" },
        "subscriptionStatus": { "type": "string", "description": "Current status (trialing, active, cancelled, expired)" },
        "subscriptionPlan": { "type": "string", "description": "Plan (monthly, yearly, free_trial)" },
        "currentPeriodEnd": { "type": "string", "description": "Expiration timestamp ISO" },
        "paypalSubscriptionId": { "type": "string", "description": "PayPal Subscription ID" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      }
    },
    "fieldObservations": {
      "fields": {
        "id": { "type": "string", "description": "Observation record ID" },
        "userId": { "type": "string", "description": "Observer user ID" },
        "cropType": { "type": "string", "description": "Target crop species" },
        "observedCondition": { "type": "string", "description": "Diagnostic condition" },
        "severity": { "type": "string", "description": "Severity scale" },
        "timestamp": { "type": "string", "description": "Observation timestamp" },
        "notes": { "type": "string", "description": "Detailed agronomist notes" }
      }
    },
    "soilReadings": {
      "fields": {
        "id": { "type": "string", "description": "Sensor probe reading ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "fieldPlotId": { "type": "string", "description": "Field sector/plot identifier" },
        "soilPh": { "type": "number", "description": "Soil pH level" },
        "soilMoistureVwc": { "type": "number", "description": "Moisture volumetric water percentage" },
        "timestamp": { "type": "string", "description": "Sensor reading timestamp" }
      }
    },
    "subscriptions": {
      "fields": {
        "id": { "type": "string", "description": "Subscription record ID" },
        "userId": { "type": "string", "description": "Customer ID" },
        "subscriptionID": { "type": "string", "description": "PayPal Subscription ID" },
        "plan": { "type": "string", "description": "Plan identifier" },
        "status": { "type": "string", "description": "Subscription status" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      }
    }
  },
  "rules": {
    "users": {
      "read": "request.auth != null",
      "write": "request.auth != null && (request.auth.uid == userId || request.resource.data.id == request.auth.uid)"
    },
    "fieldObservations": {
      "read": "request.auth != null",
      "write": "request.auth != null"
    },
    "soilReadings": {
      "read": "request.auth != null",
      "write": "request.auth != null"
    },
    "subscriptions": {
      "read": "request.auth != null",
      "write": "request.auth != null"
    }
  }
}
